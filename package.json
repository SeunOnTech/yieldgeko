{
  "name": "yieldgeko",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "prepare": "husky",
    "scout": "sh -c 'OUT_DIR=\"/tmp/yieldgeko-opportunity-scout\" && rm -rf \"$OUT_DIR\" && mkdir -p \"$OUT_DIR\" && pnpm --dir packages/agent exec tsc --ignoreConfig \"$PWD/scripts/opportunity-scout.ts\" --target ES2022 --module commonjs --types node --skipLibCheck --esModuleInterop --outDir \"$OUT_DIR\" && node \"$OUT_DIR/opportunity-scout.js\"'",
    "provider:dev": "pnpm --dir packages/provider dev",
    "provider:start": "pnpm --dir packages/provider start",
    "provider:typecheck": "pnpm --dir packages/provider typecheck",
    "provider:build": "pnpm --dir packages/provider build",
    "provider:metadata": "pnpm --dir packages/provider exec ts-node /Users/seun/yieldsync/yieldgeko/scripts/print-provider-metadata.ts",
    "attestation:fetch": "pnpm --dir packages/agent exec ts-node /Users/seun/yieldsync/yieldgeko/scripts/fetch-tee-attestation.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.26.2",
  "devDependencies": {
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.sol": [
      "forge fmt"
    ]
  }
}
